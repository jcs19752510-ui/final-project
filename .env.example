# docs/tech_conventions.md 참조. 실제 값이 든 .env는 절대 커밋하지 않음(.gitignore 처리됨).
DATABASE_URL=postgresql+asyncpg://aimock:aimock_dev_only@localhost:55432/aimock
# 로컬 기본 Postgres(5432)와 충돌 방지를 위해 55432 사용 (docker-compose.yml 참조)
JWT_SECRET=change-me-to-a-long-random-string
# GEMINI_API_KEY는 U3-a(LLM 파이프라인) 단위에서부터 필요(현재는 미사용 —
# 2026-09-08부터 GROQ로 전환, 아래 참조. 코드 자체는 남겨둬서 필요 시 재전환 가능)
GEMINI_API_KEY=
# 2026-09-08: 실사용 LLM은 GROQ 사용 — https://console.groq.com 무료 가입
# (Gemini 무료 티어가 모델당 하루 20건으로 너무 작아서 전환)
GROQ_API_KEY=
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEDIA_ENCRYPTION_KEY=
# 미디어(오디오/영상프레임) 암호화 파일 저장 위치 — 기본값 uploads
MEDIA_STORAGE_DIR=uploads

# --- 외부 배포(Render+Neon 등) 전용 — 로컬 docker-compose 개발 시엔 비워둘 것 ---
# Neon 등 관리형 Postgres 연결 시 true. DATABASE_URL엔 ?sslmode=... 를 붙이지
# 말 것(asyncpg가 인식 못해 연결 실패 — app/db.py 주석 참조), 이 플래그로만 제어.
DB_SSL_REQUIRE=false
# 배포된 프론트엔드 origin(쉼표로 여러 개, 예: https://foo.vercel.app,https://bar.onrender.com)
FRONTEND_ORIGINS=
